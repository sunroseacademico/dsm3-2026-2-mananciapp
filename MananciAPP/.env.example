# Copie este arquivo para ".env" (uso local) OU cadastre estas mesmas chaves
# como variáveis de ambiente no Render (dashboard > Environment).
# Nunca comite o arquivo ".env" de verdade — já está no .gitignore.

# ---- Banco de dados Postgres (Supabase) ----
# Painel do Supabase > botão "Connect" (topo) > Direct connection/Session
# pooler > "Connection parameters". Use o SESSION POOLER (porta 5432), não a
# "Direct connection" — essa usa IPv6 por padrão, e o Render normalmente só
# tem saída IPv4 (o Session Pooler já é proxy IPv4). O host e o usuário do
# Session Pooler são diferentes da Direct Connection (usuário vem com o
# project ref junto: "postgres.<ref>").
DB_HOST=aws-0-xxxxxxxxxx.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.xxxxxxxxxxxx
# A senha do banco é definida na criação do projeto Supabase — NÃO é a
# anon key nem a secret key. A Supabase nunca reexibe ela depois; se perdeu,
# tem um botão "Reset database password" no mesmo painel de Connect.
DB_PASS=

# ---- Banco de dados — ambiente LOCAL (opcional) ----
# Deixe DB_HOST_LOCAL em branco pra usar o MESMO Postgres do Supabase acima
# também no XAMPP local. Só preencha se quiser um Postgres local separado
# (ex.: pra testar sem tocar nos dados de produção).
DB_HOST_LOCAL=
DB_PORT_LOCAL=5432
DB_NAME_LOCAL=postgres
DB_USER_LOCAL=postgres
DB_PASS_LOCAL=

# ---- Cloudflare R2 (armazenamento dos vídeos) ----
# Como funciona: seção 5 de DEPLOY_RENDER.md. Sem estas 4 variáveis o admin
# não consegue enviar vídeos e as aulas aparecem como "Indisponível".
# R2_ACCOUNT_ID: painel da Cloudflare > R2 Object Storage (lado direito da
# página) — é o mesmo ID que aparece na URL do painel.
R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY: R2 > Manage API Tokens > Create API
# token, permissão "Leitura/gravação para objeto" só no bucket do app. O secret só
# aparece UMA vez e fica só no servidor (nunca vai pro navegador).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Nome do bucket (privado). Local e Render usam o mesmo, porque usam o mesmo
# banco (o IDCT_URL "r2:..." precisa achar o arquivo nos dois).
R2_BUCKET=mananciapp-videos-homolog

# ---- E-mail transacional (Brevo ou compatível) ----
EMAIL_API_KEY=
EMAIL_SENDER_EMAIL=
EMAIL_SENDER_NAME="Missão Manancial"

# SITE_URL_PUBLICA: endereço do site usado nos links que vão por e-mail (ex.:
# link de "Esqueci minha senha"). Fixo de propósito — não pode vir do
# cabeçalho Host da requisição, que quem faz o pedido controla. Em branco =
# https://mananciapp-render-homolog.onrender.com/. Para testar o link no
# XAMPP, use http://localhost:8000/.
SITE_URL_PUBLICA=

# SENHA_CHECAR_VAZADAS: cadastro, redefinição e troca de senha recusam senhas
# que aparecem em vazamentos conhecidos (Have I Been Pwned; só os 5 primeiros
# caracteres do SHA-1 da senha saem do servidor). Em branco = ligado; 0 =
# desligado. Se a API não responder em 3 s, a senha é aceita.
SENHA_CHECAR_VAZADAS=

# ---- OneSignal (notificações push) ----
# ONESIGNAL_APP_ID: painel do OneSignal > Settings > Keys & IDs, campo
# "OneSignal App ID". É público (já vai pro navegador de qualquer visitante
# via php/includes/pwa_head.php/index.html) — pode deixar em branco pra usar
# o valor padrão já hardcoded no código (o app já configurado do projeto).
ONESIGNAL_APP_ID=
# ONESIGNAL_REST_API_KEY: mesma tela, campo "REST API Key" — essa é SECRETA
# (nunca vai pro navegador, só o backend usa pra mandar push via API). Sem
# ela, onesignal_enviar_push() (php/conexao.php) simplesmente não manda nada
# — o resto do app funciona normal.
ONESIGNAL_REST_API_KEY=
# ONESIGNAL_EXTERNAL_ID_SEGREDO: sequência longa e aleatória (invente uma).
# Com ela, o identificador do fiel na OneSignal deixa de ser adivinhável
# ("fiel-42" vira "fiel-42-<código>") e ninguém consegue se passar por outro
# fiel no console do navegador para receber os pushes dele. Ao ligar (ou
# trocar), cada aparelho volta a receber push quando o fiel abrir o app de
# novo. Em branco = identificador antigo, sem proteção. Não troque à toa.
ONESIGNAL_EXTERNAL_ID_SEGREDO=

# LEMBRETE_CRON_CHAVE: segredo que o agendador manda para lembrete_diario.php
# (só no cabeçalho X-Cron-Chave). Invente uma sequência longa e
# aleatória e use a mesma no agendador (Cron Job do Render ou cron-job.org,
# a cada 15 min). Sem ela, o lembrete diário (T23) não é enviado.
LEMBRETE_CRON_CHAVE=

# ---- Asaas (assinaturas) ----
# Ver docs/interno/assinaturas/assinaturas_asaas.md. Sem ASAAS_API_KEY, a tela de assinar
# (php/fiel/assinar.php) só mostra "ainda não disponível" — o resto do app
# funciona normal.
# ASAAS_API_URL: sandbox (testes, sem dinheiro de verdade) =
# https://api-sandbox.asaas.com/v3 (padrão se ficar em branco);
# produção = https://api.asaas.com/v3.
ASAAS_API_URL=
# ASAAS_API_KEY: painel do Asaas > Integrações > Chave de API ($aact_...).
# SECRETA — só o backend usa. Sandbox e produção têm chaves diferentes.
ASAAS_API_KEY=
# ASAAS_WEBHOOK_TOKEN: o "Token de autenticação" que você mesmo define ao
# cadastrar o webhook no painel do Asaas (URL:
# https://<dominio>/webhook_asaas.php). SECRETO e diferente da API key —
# use um valor aleatório longo.
ASAAS_WEBHOOK_TOKEN=
# ASAAS_PIX_CHAVE (opcional): chave Pix da conta do Asaas usada no QR Code
# do "Pix com o valor que quiser" das contribuições. Vazio = usa a primeira
# chave Pix ativa da conta (painel do Asaas > Pix > Minhas chaves); sem
# nenhuma chave, o QR não aparece e só a contribuição com valor funciona.
ASAAS_PIX_CHAVE=
# Abrir/fechar as assinaturas para os fiéis e o bloqueio de conteúdo NÃO são
# variáveis: ficam em Admin > Assinaturas ("Assinaturas para os fiéis" e
# "Quem pode assistir"). Fechadas por padrão; as contribuições funcionam igual.
# Dias de acesso que continuam valendo depois do vencimento (atraso de
# Pix/boleto).
ASSINATURA_TOLERANCIA_DIAS=5
# As contribuições em missões (T32) usam a mesma conta e as mesmas
# variáveis do Asaas.

# ---- Superadmin (equipe interna) ----
# E-mails, separados por vírgula, dos admins da EQUIPE: só eles veem
# Admin > Financeiro (lucro, divisão e repasses) e as contribuições de
# missões com os nomes. A conta precisa ser admin no app também. Em branco,
# ninguém vê o Financeiro. Só ponha e-mails de contas que JÁ existem: um
# e-mail ainda livre poderia ser cadastrado por outra pessoa. Ver
# docs/interno/financeiro.md.
SUPERADMIN_EMAILS=

# ---- APP_CHAVE (chave do app) ----
# Cifra no banco a chave da verificação em duas etapas dos admins: quem só
# lê a tabela id_fiel (backup, acesso indevido ao Supabase) não gera os
# códigos. Sequência aleatória de 32+ letras, uma por ambiente; gere com
#   openssl rand -base64 32
# Em branco (ou curta), a chave fica sem cifra, como antes. As chaves antigas
# são cifradas no próximo login certo de cada admin. NUNCA troque nem apague
# depois de definida: as chaves cifradas deixam de abrir e o admin só entra
# com um código de reserva (ou o superadmin desliga o 2FA dele).
APP_CHAVE=

# ---- Página de contato (php/fiel/contato.php) ----
# Dados mostrados na página (linha em branco não aparece) e o endereço do
# formulário no Formspree da organização (https://formspree.io/f/<id>). Sem
# CONTATO_FORMSPREE_URL o formulário continua indo para a conta de TESTE.
CONTATO_EMAIL=
CONTATO_TELEFONE=
CONTATO_ENDERECO=
CONTATO_FORMSPREE_URL=

# ---- Sessões ----
# SESSOES_NO_BANCO=1 guarda as sessões no Postgres (tabela da seção 70 do
# bancosupabase.md) em vez de arquivo no container: deploy, reinício e
# hibernação do Render deixam de deslogar todo mundo. Só ligue DEPOIS de
# rodar a seção 70. Vale no Render (Dockerfile); no XAMPP fica em arquivo.
SESSOES_NO_BANCO=0

# ---- Alerta de erros (Sentry, opcional) ----
# DSN do projeto PHP no sentry.io (Settings → Client Keys). Com ela, erro
# fatal e erro de banco viram alerta por e-mail (sem e-mail, senha, token
# nem corpo do POST). Vazia: nada muda. Uma por ambiente.
SENTRY_DSN=

# ---- CAPTCHA invisível (Cloudflare Turnstile, opcional) ----
# Cloudflare → Turnstile → Add site (modo "Managed", domínio do site). Com as
# duas, o cadastro e o "Esqueci minha senha" pedem o quadrinho anti-robô.
# Vazias: nada muda.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Capacidade (só no Render) ----
# Processos do Apache = requisições PHP ao mesmo tempo. 20 cabe no plano
# free (512 MB). Referência: ~35 MB por processo; Standard (2 GB) → 40;
# Pro (4 GB) → 80. Workers × instâncias precisa caber no "Pool Size" do
# Supabase (Database → Settings → Connection pooling), com folga de ~5.
APACHE_MAX_WORKERS=20

# ---- Segurança do navegador (CSP) ----
# As páginas PHP só rodam script com nonce (site_csp_politica() em
# php/conexao.php). CSP_SO_AVISAR=1: a política nova só avisa no Console do
# navegador e a antiga (com 'unsafe-inline', do .htaccess) volta a valer —
# para destravar uma tela que a CSP quebrou sem reverter código. Normal: 0.
CSP_SO_AVISAR=0
